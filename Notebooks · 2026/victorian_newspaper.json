[{"prunedResult":{"model_settings":{"use_doc_preprocessor":false,"use_layout_detection":true,"use_chart_recognition":false,"use_seal_recognition":true,"use_ocr_for_image_block":false,"format_block_content":true,"merge_layout_blocks":true,"markdown_ignore_labels":["number","footnote","header","header_image","footer","footer_image","aside_text"],"return_layout_polygon_points":true},"parsing_res_list":[{"block_label":"header","block_content":"DE BILLE ORINIGES","block_bbox":[252,77,347,85],"block_id":0,"group_id":0,"block_polygon_points":[[252.0,76.99999237060547],[346.0,76.99999237060547],[346.0,83.99999237060547],[252.0,83.99999237060547]]},{"block_label":"header","block_content":"A9903: 17.795","block_bbox":[460,76,511,84],"block_id":1,"group_id":1,"block_polygon_points":[[460.0,76.0],[510.0,76.0],[510.0,83.0],[460.0,83.0]]},{"block_label":"header","block_content":"Serrano 14, 1923","block_bbox":[88,96,144,104],"block_id":2,"group_id":2,"block_polygon_points":[[87.99998474121094,95.99999237060547],[142.99998474121094,95.99999237060547],[142.99998474121094,102.99999237060547],[87.99998474121094,102.99999237060547]]},{"block_label":"header","block_content":"PUBLIC OPINION","block_bbox":[254,92,350,103],"block_id":3,"group_id":3,"block_polygon_points":[[254.0,92.0],[349.0,92.0],[349.0,102.0],[254.0,102.0]]},{"block_label":"header","block_content":"26r","block_bbox":[495,92,511,102],"block_id":4,"group_id":4,"block_polygon_points":[[495.0,92.0],[510.0,92.0],[510.0,101.0],[495.0,101.0]]},{"block_label":"paragraph_title","block_content":"## A GREAT SCIENTIST","block_bbox":[97,115,204,124],"block_id":5,"block_order":1,"group_id":5,"block_polygon_points":[[97.0,115.0],[203.0,115.0],[203.0,123.0],[97.0,123.0]]},{"block_label":"text","block_content":"THE death is announced of Major Ernest Francis Bashford, M.D., O.B.E., late Director of the Imperial Cancer Research Fund and Adviser in Pathology to the Army on the Rhine.","block_bbox":[79,125,223,178],"block_id":6,"block_order":2,"group_id":6,"block_polygon_points":[[83.0,125.0],[222.0,125.0],[222.0,177.0],[83.0,177.0]]},{"block_label":"text","block_content":"\"A self-made man, bumble-minded, of the simplest tastes, Basiford was of the type usually associated with the German professor of pre-war days, living frugally and thinking highly,\" says the Times. \"Yet when at his best and before illness overtook him, he had very great driving power, and was well fitted to be at the head of the important scientific laboratory to which he literally devoted his life.","block_bbox":[80,176,223,281],"block_id":7,"block_order":3,"group_id":7,"block_polygon_points":[[80,181],[80,280],[222,280],[222,176],[112,176],[107,176],[96,176]]},{"block_label":"text","block_content":"\" A good biologist and a good chemist, for he had been trained at the Pharmacological Laboratory in Berlin, he was fertile in experiment and in the suggestion of new lines of work, while he was of such sound judgment that the only use he had for a hypothesis was to put it to the test of experiment. But even at the age of 49 he had done his life's work, and we should be thankful that he was spared to do so much and to make so clear a path for those who have succeeded him. What he did was spade work, but the foundation was well and truly laid, and any superstructure can be safely built upon it.\"","block_bbox":[79,281,223,439],"block_id":8,"block_order":4,"group_id":8,"block_polygon_points":[[79.0,281.0],[223.0,281.0],[223.0,439.0],[79.0,439.0]]},{"block_label":"paragraph_title","block_content":"## FRIENDS IN THE EUSTON ROAD","block_bbox":[86,442,217,462],"block_id":9,"block_order":5,"group_id":9,"block_polygon_points":[[86.0,442.0],[216.0,442.0],[216.0,461.0],[86.0,461.0]]},{"block_label":"text","block_content":"\"EVERY Scotsman arriving at Euston knows the oblong tract of greensward and trees which lies athwart the Euston Road immediately in front of the railway station,\" says the Glasgow Herald. \"It is variously known as Euston Square or Endsleigh Gardens, the fate of which has hung in the balance for some time.","block_bbox":[73,465,224,551],"block_id":10,"block_order":6,"group_id":10,"block_polygon_points":[[73.0,465.0],[224.0,465.0],[224.0,551.0],[73.0,551.0]]},{"block_label":"text","block_content":"\"A hundred years ago or more it was a large nursery garden, famous for the perfume of its flowers, yet so far away from the City that coachmen bidden to drive there would facetiously ask where they were to change horses. The St. Fancras Council had the opportunity recently of acquiring the gardens for £50,000, but they could not raise the money, and now the Society of Friends has the option of building there, and they propose putting up their new headquarters.\"","block_bbox":[79,551,224,673],"block_id":11,"block_order":7,"group_id":11,"block_polygon_points":[[79.0,551.0],[224.0,551.0],[224.0,673.0],[79.0,673.0]]},{"block_label":"text","block_content":"\" At least some of them do, but other members object to the building schemes, and make the bold suggestion that the Friends should make over the open space to the Metropolitan Public Gardens Association, to be used as a public garden for ever. One hopes that the more aesthetic plan will prevail. Euston Road has too few open spaces that it can afford to lose the patch of greenery which seems to act as a front garden to the gateway to the North.\"","block_bbox":[78,673,224,796],"block_id":12,"block_order":8,"group_id":12,"block_polygon_points":[[78.0,673.0],[224.0,673.0],[224.0,796.0],[78.0,796.0]]},{"block_label":"text","block_content":"More Parables of Sajed the Sage,\" the fourth series, can be obtained for 55. 4d., post free, from Puric Oristos office.","block_bbox":[81,802,225,839],"block_id":13,"block_order":9,"group_id":13,"block_polygon_points":[[81.0,802.0],[225.0,802.0],[225.0,839.0],[81.0,839.0]]},{"block_label":"image","block_content":"<div style=\"text-align: center;\"><img src=\"imgs/img_in_image_box_235_151_300_215.jpg\" alt=\"Im